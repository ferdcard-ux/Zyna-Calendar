#!/usr/bin/env bash

set -euo pipefail

export NO_AT_BRIDGE=1
export PYTHONUNBUFFERED=1

APP_PATH="/opt/zyna-calendar/main.py"
APP_DIR="/opt/zyna-calendar"
TOKEN_PATH="${HOME}/.config/zyna-calendar/token.json"

# Resuelve el intérprete: prioridad al venv interno de la app.
if [[ -x "${APP_DIR}/venv/bin/python3" ]]; then
    PYTHON="${APP_DIR}/venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="$(command -v python3)"
else
    echo "No se encontro un intérprete de Python." >&2
    exit 1
fi

PROBE_CODE="import sys, warnings; \
warnings.filterwarnings('ignore', category=FutureWarning, module='google.api_core._python_version_support'); \
from core.auth import launcher_exit_code, probe_token_state; \
sys.exit(launcher_exit_code(probe_token_state()))"

needs_terminal=0
auth_probe_status=0
if ! (cd "${APP_DIR}" && "${PYTHON}" -c "${PROBE_CODE}" 2>/dev/null); then
    auth_probe_status=$?
fi

# 10=sin token, 11=sin refresh_token, 20=token revocado. Requieren terminal.
# 30=problema de red/DNS: se permite arrancar la app en modo offline/caché.
if [[ "${auth_probe_status}" -eq 10 || "${auth_probe_status}" -eq 11 || "${auth_probe_status}" -eq 20 ]]; then
    needs_terminal=1
fi

if [[ "${needs_terminal}" -eq 1 ]]; then
    terminal_cmd=""
    for term in xfce4-terminal mate-terminal gnome-terminal tilix x-terminal-emulator; do
        if command -v "${term}" >/dev/null 2>&1; then
            terminal_cmd="${term}"
            break
        fi
    done

    if [[ -z "${terminal_cmd}" ]]; then
        echo "No se encontro un emulador de terminal. Ejecuta manualmente:" >&2
        echo "  cd ${APP_DIR} && ${PYTHON} -c 'from core.auth import load_google_credentials; load_google_credentials(force_reauth=True)'" >&2
        exit 1
    fi

    if [[ "${terminal_cmd}" == "x-terminal-emulator" ]]; then
        exec "${terminal_cmd}" -e bash -lc "
cd '${APP_DIR}'
${PYTHON} -c 'from core.auth import load_google_credentials; load_google_credentials(force_reauth=True)'
auth_status=\$?
echo
if [[ \${auth_status} -eq 0 ]]; then
    echo 'Autenticación completada. Zyna Calendar se abrirá ahora.'
    nohup '${PYTHON}' '${APP_PATH}' >/dev/null 2>&1 </dev/null &
else
    echo 'La autenticación no se completó. La app no se abrirá hasta que finalice correctamente.'
fi
echo
read -p 'Presione Enter para salir...' _
"
    else
        exec "${terminal_cmd}" --disable-server --command="bash -lc '
cd \"${APP_DIR}\"
${PYTHON} -c \"import warnings; warnings.filterwarnings(\\\"ignore\\\", category=FutureWarning, module=\\\"google.api_core._python_version_support\\\"); from core.auth import load_google_credentials; load_google_credentials(force_reauth=True)\"
auth_status=\$?
echo
if [[ \${auth_status} -eq 0 ]]; then
    echo \"Autenticación completada. Zyna Calendar se abrirá ahora.\"
    nohup ${PYTHON} \"${APP_PATH}\" >/dev/null 2>&1 </dev/null &
else
    echo \"La autenticación no se completó. La app no se abrirá hasta que finalice correctamente.\"
fi
echo
read -p \"Presione Enter para salir...\" _
'"
    fi
fi

exec "${PYTHON}" "${APP_PATH}"